{
  "_comment": "LTX 2.3 22B distilled-1.1 image->video, single-stage, video-only output (audio latent is sampled jointly - the model is AV-native and requires it - but only the video half is decoded). Derived from the Civitai 'LTX-2.3 DEV/DIST' workflow (2993540) minus its Ollama/upscale/NAG extras: euler + linear_quadratic 22 steps at CFG 1 (distilled needs no negative pass), LTXVPreprocess img_compression 0, fps 24. resolve.py overwrites: filenames from model_map (unet/dual-clip/both vaes/lora), prompt texts, seed on RandomNoise, width/height on ImageScale + EmptyLTXVLatentVideo, and the 8n+1 frame count converted from the app's 16fps length (see fps handling in resolve.py).",
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "ltx-2.3-22b-distilled-1.1_transformer_only_fp8_scaled.safetensors", "weight_dtype": "default" } },
  "2": { "class_type": "LTX2LoraLoaderAdvanced", "inputs": { "lora_name": "ltx23_gurren_lagann.safetensors", "model": ["1", 0], "strength_model": 1.0, "video": 1.0, "video_to_audio": 1.0, "audio": 1.0, "audio_to_video": 1.0, "other": 1.0 } },
  "3": { "class_type": "DualCLIPLoader", "inputs": { "clip_name1": "gemma_3_12B_it_fp8_scaled.safetensors", "clip_name2": "ltx-2.3_text_projection_bf16.safetensors", "type": "ltxv", "device": "cpu" } },
  "4": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["3", 0], "text": "POSITIVE" } },
  "5": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["3", 0], "text": "NEGATIVE" } },
  "6": { "class_type": "LTXVConditioning", "inputs": { "positive": ["4", 0], "negative": ["5", 0], "frame_rate": 24.0 } },
  "7": { "class_type": "VAELoader", "inputs": { "vae_name": "LTX23_video_vae_bf16.safetensors" } },
  "8": { "class_type": "VAELoader", "inputs": { "vae_name": "LTX23_audio_vae_bf16.safetensors" } },
  "9": { "class_type": "LoadImage", "inputs": { "image": "input.png" } },
  "24": { "class_type": "ImageScale", "inputs": { "image": ["9", 0], "upscale_method": "lanczos", "width": 832, "height": 480, "crop": "center" } },
  "10": { "class_type": "LTXVPreprocess", "inputs": { "image": ["24", 0], "img_compression": 0 } },
  "11": { "class_type": "EmptyLTXVLatentVideo", "inputs": { "width": 832, "height": 480, "length": 121, "batch_size": 1 } },
  "12": { "class_type": "LTXVImgToVideoInplace", "inputs": { "vae": ["7", 0], "image": ["10", 0], "latent": ["11", 0], "strength": 1.0, "bypass": false } },
  "13": { "class_type": "LTXVEmptyLatentAudio", "inputs": { "frames_number": 121, "frame_rate": 24, "batch_size": 1, "audio_vae": ["8", 0] } },
  "14": { "class_type": "LTXVConcatAVLatent", "inputs": { "video_latent": ["12", 0], "audio_latent": ["13", 0] } },
  "15": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
  "16": { "class_type": "BasicScheduler", "inputs": { "model": ["2", 0], "scheduler": "linear_quadratic", "steps": 22, "denoise": 1.0 } },
  "17": { "class_type": "RandomNoise", "inputs": { "noise_seed": 42 } },
  "18": { "class_type": "CFGGuider", "inputs": { "model": ["2", 0], "positive": ["6", 0], "negative": ["6", 1], "cfg": 1.0 } },
  "19": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["17", 0], "guider": ["18", 0], "sampler": ["15", 0], "sigmas": ["16", 0], "latent_image": ["14", 0] } },
  "20": { "class_type": "LTXVSeparateAVLatent", "inputs": { "av_latent": ["19", 0] } },
  "21": { "class_type": "VAEDecode", "inputs": { "samples": ["20", 0], "vae": ["7", 0] } },
  "22": { "class_type": "CreateVideo", "inputs": { "images": ["21", 0], "fps": 24.0 } },
  "23": { "class_type": "SaveVideo", "inputs": { "video": ["22", 0], "filename_prefix": "neon/ltx", "format": "mp4", "codec": "h264" } }
}
