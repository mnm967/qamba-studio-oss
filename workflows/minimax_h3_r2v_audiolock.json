{
  "_comment": "MiniMax-H3 reference->video with the SOURCE AUDIO LOCKED (music-video mode). Identical to minimax_h3_r2v.json until the sampler, plus: (16) LoadAudio stages the block's pre-sliced wav (resolve.py injects the filename via `source_audio`); the same AUDIO feeds BOTH the conditioning node's ref_audios.ref_audio_0 slot (so the prompt can bind it as <Audio 1>) AND (17) VRGDG_MiniMaxH3AudioDrive, which encodes it into the joint AV latent with a zero denoise mask on the audio half — H3 then generates only the picture, in sync with the locked track. The sampler consumes the audio-locked latent (17,0) instead of the raw one, and CreateVideo muxes AudioDrive's untouched pass-through waveform (17,1) rather than a VAEDecodeAudio round-trip, so the released file carries the exact source samples. resolve.py wires ref slots and prompt as usual.",
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "minimax_h3_ref2va_int8_convrot.safetensors", "weight_dtype": "default" } },
  "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors", "type": "minimax", "device": "default" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" } },
  "4": { "class_type": "VAELoader", "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" } },
  "5": { "class_type": "LoadImage", "inputs": { "image": "example.png" } },
  "16": { "class_type": "LoadAudio", "inputs": { "audio": "AUDIO_SLICE.wav" } },
  "6": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "audio_vae": ["4", 0],
      "prompt": "POSITIVE",
      "width": 832,
      "height": 480,
      "length": 124,
      "ref_image_size": "match",
      "ref_images.ref_image_0": ["5", 0],
      "ref_audios.ref_audio_0": ["16", 0]
    }
  },
  "17": {
    "class_type": "VRGDG_MiniMaxH3AudioDrive",
    "inputs": { "av_latent": ["6", 1], "source_audio": ["16", 0], "audio_vae": ["4", 0] }
  },
  "7": { "class_type": "BasicGuider", "inputs": { "model": ["1", 0], "conditioning": ["6", 0] } },
  "8": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "res_multistep" } },
  "9": { "class_type": "BasicScheduler", "inputs": { "model": ["1", 0], "scheduler": "simple", "steps": 20, "denoise": 1.0 } },
  "10": { "class_type": "RandomNoise", "inputs": { "noise_seed": 42 } },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["10", 0],
      "guider": ["7", 0],
      "sampler": ["8", 0],
      "sigmas": ["9", 0],
      "latent_image": ["17", 0]
    }
  },
  "12": { "class_type": "VAEDecode", "inputs": { "samples": ["11", 0], "vae": ["3", 0] } },
  "14": { "class_type": "CreateVideo", "inputs": { "images": ["12", 0], "audio": ["17", 1], "fps": 24.0 } },
  "15": { "class_type": "SaveVideo", "inputs": { "video": ["14", 0], "filename_prefix": "neon/minimax_h3_audiolock", "format": "auto", "codec": "auto" } }
}
