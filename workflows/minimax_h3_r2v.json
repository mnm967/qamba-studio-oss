{
  "_comment": "MiniMax-H3 reference->video with native audio. This is the mode that feeds the board's linked character/environment references INTO the video rather than only into the still. Differences from minimax_h3_i2v.json: (1) a different checkpoint — ref2va, not fl2va; (2) MiniMaxH3ReferenceToVideo also takes audio_vae; (3) references arrive through ComfyUI's autogrow inputs, named `ref_images.ref_image_N`, so resolve.py adds/removes those keys and their LoadImage nodes to match how many refs the shot actually has (the node accepts ref_videos / ref_audios the same way — unused here). There is no start frame: composition comes entirely from the prompt plus the references. `ref_image_size: match` keeps the refs at their own aspect instead of squashing them to the output frame.",
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "minimax_h3_ref2va_int8_convrot.safetensors", "weight_dtype": "default" } },
  "2": { "class_type": "CLIPLoader", "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors", "type": "minimax", "device": "default" } },
  "3": { "class_type": "VAELoader", "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" } },
  "4": { "class_type": "VAELoader", "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" } },
  "5": { "class_type": "LoadImage", "inputs": { "image": "example.png" } },
  "6": {
    "class_type": "MiniMaxH3ReferenceToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "audio_vae": ["4", 0],
      "prompt": "POSITIVE",
      "width": 832,
      "height": 480,
      "length": 124,
      "ref_image_size": "match",
      "ref_images.ref_image_0": ["5", 0]
    }
  },
  "7": { "class_type": "BasicGuider", "inputs": { "model": ["1", 0], "conditioning": ["6", 0] } },
  "8": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "res_multistep" } },
  "9": { "class_type": "BasicScheduler", "inputs": { "model": ["1", 0], "scheduler": "simple", "steps": 20, "denoise": 1.0 } },
  "10": { "class_type": "RandomNoise", "inputs": { "noise_seed": 42 } },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["10", 0],
      "guider": ["7", 0],
      "sampler": ["8", 0],
      "sigmas": ["9", 0],
      "latent_image": ["6", 1]
    }
  },
  "12": { "class_type": "VAEDecode", "inputs": { "samples": ["11", 0], "vae": ["3", 0] } },
  "13": { "class_type": "VAEDecodeAudio", "inputs": { "samples": ["11", 0], "vae": ["4", 0] } },
  "14": { "class_type": "CreateVideo", "inputs": { "images": ["12", 0], "audio": ["13", 0], "fps": 24.0 } },
  "15": { "class_type": "SaveVideo", "inputs": { "video": ["14", 0], "filename_prefix": "neon/minimax_h3_r2v", "format": "auto", "codec": "auto" } }
}
