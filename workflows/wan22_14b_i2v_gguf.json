{
  "_comment": "Wan 2.2 14B MoE i2v — GGUF quants, MOTION-PRESERVING hybrid (aws tier, L4 24GB). The pure 'COMPACT + SPEED' lightning 4+4 recipe (lightning LoRA at 1.0 on BOTH experts, cfg 1.0) renders almost static clips: in Wan 2.2's MoE split the HIGH-noise expert creates the motion, and the 4-step distill LoRA buys its speed by flattening exactly that. So the high-noise pass now runs the raw expert at real guidance (cfg 3.5, no LoRA) to establish movement, and lightning stays on the LOW-noise expert where it only accelerates detail. shift 8.0 also favours motion at 480p. Costs ~1.7x the sampling of 4+4. resolve.py rewrites unet/clip/vae names from model_map, so 'animegen' resolves through this same template. Do NOT set WORKER_STEPS on this tier — the step split is part of the recipe.",
  "1": { "class_type": "UnetLoaderGGUF", "inputs": { "unet_name": "wan2.2_i2v_high_noise_14B_Q4_K_M.gguf" } },
  "2": { "class_type": "UnetLoaderGGUF", "inputs": { "unet_name": "wan2.2_i2v_low_noise_14B_Q4_K_M.gguf" } },
  "17": { "class_type": "LoraLoaderModelOnly", "inputs": { "model": ["2", 0], "lora_name": "wan2.2_i2v_lightx2v_4steps_lora_v1_low_noise.safetensors", "strength_model": 1.0 } },
  "3": { "class_type": "CLIPLoader", "inputs": { "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default" } },
  "4": { "class_type": "VAELoader", "inputs": { "vae_name": "wan_2.1_vae.safetensors" } },
  "5": { "class_type": "CLIPTextEncode", "inputs": { "text": "cinematic anime, neon city", "clip": ["3", 0] } },
  "6": { "class_type": "CLIPTextEncode", "inputs": { "text": "blurry, low quality, watermark, text", "clip": ["3", 0] } },
  "7": { "class_type": "ModelSamplingSD3", "inputs": { "model": ["1", 0], "shift": 8.0 } },
  "8": { "class_type": "ModelSamplingSD3", "inputs": { "model": ["17", 0], "shift": 8.0 } },
  "15": { "class_type": "LoadImage", "inputs": { "image": "example.png" } },
  "9": { "class_type": "WanImageToVideo", "inputs": { "positive": ["5", 0], "negative": ["6", 0], "vae": ["4", 0], "width": 832, "height": 480, "length": 81, "batch_size": 1, "start_image": ["15", 0] } },
  "10": { "class_type": "KSamplerAdvanced", "inputs": { "model": ["7", 0], "add_noise": "enable", "noise_seed": 0, "steps": 10, "cfg": 3.5, "sampler_name": "euler", "scheduler": "simple", "positive": ["9", 0], "negative": ["9", 1], "latent_image": ["9", 2], "start_at_step": 0, "end_at_step": 4, "return_with_leftover_noise": "enable" } },
  "11": { "class_type": "KSamplerAdvanced", "inputs": { "model": ["8", 0], "add_noise": "disable", "noise_seed": 0, "steps": 10, "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "positive": ["9", 0], "negative": ["9", 1], "latent_image": ["10", 0], "start_at_step": 4, "end_at_step": 10000, "return_with_leftover_noise": "disable" } },
  "12": { "class_type": "VAEDecode", "inputs": { "samples": ["11", 0], "vae": ["4", 0] } },
  "13": { "class_type": "CreateVideo", "inputs": { "images": ["12", 0], "fps": 16 } },
  "14": { "class_type": "SaveVideo", "inputs": { "video": ["13", 0], "filename_prefix": "neon/wan14b_i2v_gguf", "format": "auto", "codec": "auto" } }
}
