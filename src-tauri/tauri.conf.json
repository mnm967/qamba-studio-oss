{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qamba Studio",
  "version": "0.2.3",
  "identifier": "studio.qamba.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Qamba Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**"
        ]
      },
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https: http://127.0.0.1:* http://localhost:8188",
        "media-src": "'self' asset: http://asset.localhost data: blob: https: http://127.0.0.1:* http://localhost:8188",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "connect-src": "'self' asset: http://asset.localhost ipc: http://ipc.localhost https: wss: ws://127.0.0.1:8188 http://127.0.0.1:* http://localhost:8188"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Qamba Studio contributors",
    "license": "AGPL-3.0-or-later",
    "category": "Video",
    "shortDescription": "AI video builder",
    "longDescription": "Storyboard, generate and edit AI video on your own machine.",
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg"
        ]
      }
    },
    "resources": {
      "../worker/*.py": "worker/",
      "../workflows/*.json": "workflows/",
      "../infra/model_map.desktop.json": "infra/model_map.desktop.json",
      "../worker/handlers/*.py": "worker/handlers/",
      "../director/knowledge/*.md": "director/knowledge/"
    }
  }
}
